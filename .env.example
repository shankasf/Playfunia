# ===========================================
# Playfunia Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# This single .env file is used by all services

# ===========================================
# General
# ===========================================
NODE_ENV=development

# ===========================================
# Backend Configuration
# ===========================================
PORT=5000
JWT_SECRET=your-jwt-secret-here

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Supabase Configuration (Database & Auth)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ===========================================
# Frontend Configuration (React App)
# ===========================================
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_CHATBOT_URL=http://localhost:8000/chatbot
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# Square Payment Integration
# ===========================================
# Get these from Square Developer Dashboard: https://developer.squareup.com/
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox

# ===========================================
# Stripe Payment Integration (Optional)
# ===========================================
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Enable mock payments for development (bypasses real payment processing)
MOCK_PAYMENTS=false

# ===========================================
# Chatbot Service (OpenAI)
# ===========================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
CHATBOT_ALLOWED_ORIGIN=*
CHATBOT_SERVICE_URL=http://localhost:8000

# ===========================================
# Instagram Feed Integration (Optional)
# ===========================================
# Get these from Meta Business Suite / Instagram Basic Display API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_USER_ID=your-instagram-user-id

# ===========================================
# Admin Configuration
# ===========================================
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

# ===========================================
# SMTP Email Configuration (Legacy - now using Supabase Auth)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@playfunia.com
SMTP_FROM_NAME=Playfunia
