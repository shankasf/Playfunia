# ===========================================
# Playfunia Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# This single .env file is used by all services

# ===========================================
# General
# ===========================================
NODE_ENV=development

# ===========================================
# Backend Configuration
# ===========================================
PORT=5000
JWT_SECRET=your-jwt-secret-here

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Supabase Configuration (Database & Auth)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ===========================================
# Frontend Configuration (React App)
# ===========================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_CHATBOT_URL=http://localhost:8000
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# Square Payment Integration
# ===========================================
# Get these from Square Developer Dashboard: https://developer.squareup.com/
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# ===========================================
# Twilio SMS Configuration
# ===========================================
# Account SID is required. Auth uses either TWILIO_AUTH_TOKEN
# OR (preferred) TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=+1234567890
# Required for A2P 10DLC routing; messages without this may be filtered.
TWILIO_MESSAGING_SERVICE_SID=

# ===========================================
# Admin Notification Emails
# ===========================================
ADMIN_EMAILS=admin@example.com

# ===========================================
# Chatbot Service (OpenAI)
# ===========================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
CHATBOT_ALLOWED_ORIGIN=*
CHATBOT_SERVICE_URL=http://localhost:8000

# ===========================================
# Instagram Feed Integration (Optional)
# ===========================================
# Get these from Meta Business Suite / Instagram Basic Display API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_USER_ID=your-instagram-user-id

# ===========================================
# Admin Configuration
# ===========================================
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

# ===========================================
# SMTP Email Configuration (Legacy - now using Supabase Auth)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=info@playfunia.com
SMTP_FROM_NAME=Playfunia
