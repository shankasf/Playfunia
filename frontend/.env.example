# Backend API URL
REACT_APP_API_URL=http://localhost:5000/api

# Chatbot Service URL (base URL without /chat endpoint)
REACT_APP_CHATBOT_URL=http://localhost:8000

# Supabase Configuration (required for authentication)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key


# Square Payment Configuration (fetched from backend, but can be overridden)
# REACT_APP_SQUARE_APPLICATION_ID=your-square-app-id
# REACT_APP_SQUARE_LOCATION_ID=your-square-location-id
